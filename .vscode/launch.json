{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch via NPM CMA",
            "type": "node",
            "request": "launch",
            "sourceMaps": true,
            "webroot":"${workspaceRoot}/src",
            "localRoot": "${workspaceFolder}/src",
            "urlFilter": "http://localhost:4000/*",
            "trace":true,
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script", "start:dev"
            ],
            "port": 4000
        }
        {
            "type": "msedge",
            "request": "attach",
            "name": "Attach to edge",
            "port": 9222,
            "urlFilter": "http://localhost:4000/*",
            "webRoot": "${workspaceFolder}"
        }        
    ]
}